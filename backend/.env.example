# ─── Application ───────────────────────────────────────────────
APP_NAME=Hissob ERP
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING
ENVIRONMENT=development

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://hissob_user:hissob_pass@localhost:5432/hissob_dev

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Uploads ───────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Super Admin ───────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@hissob.app
SUPER_ADMIN_PASSWORD=ChangeMe@123
